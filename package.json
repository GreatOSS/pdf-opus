{
  "name": "leaflark",
  "version": "0.1.0",
  "description": "Leaflark — a fast, private PDF viewer and editor that runs entirely on your device.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --port 4173 --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GreatOSS/pdf-opus.git"
  },
  "keywords": [
    "pdf",
    "pdf-viewer",
    "pdf-editor",
    "annotate",
    "pdfjs"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/GreatOSS/pdf-opus/issues"
  },
  "homepage": "https://github.com/GreatOSS/pdf-opus#readme",
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.2"
  },
  "private": true,
  "type": "module"
